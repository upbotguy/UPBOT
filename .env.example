# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Solana RPC Endpoint (e.g. Free Helius RPC: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# 32-character AES-256 Encryption Key for secure local wallet storage
ENCRYPTION_KEY=your_secret_32_character_encryption_key_here!

# SQLite Database Path
DATABASE_PATH=./quickbot.db

# Admin Whitelist (Allowed Telegram Usernames without @, comma-separated)
# Example: ADMIN_USERNAMES=your_username,co_admin_user
ADMIN_USERNAMES=your_telegram_username

# Admin User IDs (Optional, comma-separated numeric IDs)
ADMIN_USER_IDS=

# Limit Order Price Polling Interval (in milliseconds: 2000 = 2 seconds)
ORDER_POLL_INTERVAL_MS=2000
